use std::str::FromStr;
use ecow::{EcoString, EcoVec};
use lalrpop_util::ParseError;

use crate::lang::dsrv::ast::{ReconfigurableExprScope, SyntaxLiteral, VarOrNodeName};
use crate::lang::dsrv::syntax::parsed::{ParsedExprBuilder as ExprBuilder, ParsedExprKind as ExprKind, ParsedExprId as ExprId, ParsedDeclaration as Declaration, SourceAscription as StreamTypeAscription};
use crate::lang::dsrv::source::{SourceType, SourceTypeKind as StreamType, SourceAlternative, AliasDeclaration, TypeName};
use crate::core::{BinaryOperator, VarName};
use crate::lang::dsrv::patterns::{MatchArm, MatchPattern, PatternKind};
use crate::lang::dsrv::span::Span;
use crate::distributed::distribution_graphs::NodeName;

grammar(builder: &mut ExprBuilder, user_error_location: &mut Option<usize>);

// Macro to automatically wrap parsed nodes with their span information
MakeSpanned<T>: ExprId = {
    <l:@L> <node:T> <r:@R> => builder.alloc(node, Span::new(l as u32, r as u32))
};

// -----------------------------------------------------------------------------
// Tokens
// -----------------------------------------------------------------------------
match {
    r"[ \t\r\n\x0B\x0C]+" => { }, // Ignore ASCII whitespace
    r"//[^\n\r]*[\n\r]*" => { }, // Ignore `// comments`
    r#"\(\*[^*]*\*+(?:[^\)*][^*]*\*+)*\)"# => { },  // Ignore `(* comments *)`
} else {
    _
}

// Case separates a tag from a name, so the two are separate terminals: a
// capitalised name applied to a payload is a constructor, never a call.
UpperIdent: &'input str = <s:r"[A-Z][A-Za-z0-9_]*"> => s;
LowerIdent: &'input str = <s:r"[a-z_][A-Za-z0-9_]*"> => s;
RawIdent: &'input str = {
    UpperIdent,
    LowerIdent,
};
Ident: VarName = <s:RawIdent> => VarName::from(s);
Uint: u64 = <l:@L> <s:r"[0-9]+"> =>? u64::from_str(s)
    .map_err(|_| {
        *user_error_location = Some(l);
        ParseError::User { error: "unsigned integer literal is out of range" }
    });
// Negative numbers handled in unary minus - but need a separate case to not accept
// numbers too large for i64 here.
Int: i64 = <l:@L> <s:r"[0-9]+"> =>? i64::from_str(s)
    .map_err(|_| {
        *user_error_location = Some(l);
        ParseError::User { error: "integer literal is out of range" }
    });
MalformedFloat: SyntaxLiteral = <l:@L> <_s:r"[0-9]+\.[0-9]+(?:\.[0-9]+)+"> =>?
    {
        *user_error_location = Some(l);
        Err(ParseError::User { error: "invalid float literal" })
    };
// A Float names its fraction: `1.0`, not `1.`. Leaving the point bare would
// take the first dot of a range, and `1.` says nothing `1.0` does not.
Float: f64 = <l:@L> <s:r"[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)|[0-9]+\.[0-9]+"> =>? {
    let value = f64::from_str(s).map_err(|_| {
        *user_error_location = Some(l);
        ParseError::User { error: "invalid float literal" }
    })?;
    if value.is_finite() {
        Ok(value)
    } else {
        *user_error_location = Some(l);
        Err(ParseError::User { error: "float literal is out of range" })
    }
};
Bool: bool = {
    "true" => true,
    "false" => false
};
String: EcoString = <s:r#""[^\\"\n\r]*(?:\\[tn'"\\][^\\"\n\r]*)*""#> => s[1..s.len()-1].into();
VarOrNodeName: VarOrNodeName = {
    RawIdent => VarOrNodeName((<>).to_owned()),
    String => VarOrNodeName((<>).to_string()),
};
PlacementNode: NodeName = {
    RawIdent => NodeName::new((<>).to_owned()),
    String => NodeName::new((<>).to_string()),
};

// -----------------------------------------------------------------------------
// Macros / generic helpers
// -----------------------------------------------------------------------------



// A list of elements separated by Sep
SepList<T, Sep>: EcoVec<T> = {
    <mut v:(<T> Sep)*> <e:T> => {
        v.push(e);
        v.into()
    }
};

// An optional list of elements separated by Sep
SepListOpt<T, Sep>: EcoVec<T> = {
    SepList<T, Sep>,
    => EcoVec::new(),
};

DelimitedSepListOpt<T, Sep>: EcoVec<T> = {
    <mut v:(<T> Sep)*> <last:T?> => {
        if let Some(last) = last {
            v.push(last);
        }
        v.into()
    },
};

// Key-value pair:
KVPair<K, V>: (K, V) = {
    <k: K> ":" <v: V> => (k, v)
};

ExprKVPair: (EcoString, ExprId) = {
    <k: String> ":" <v: Expr> => (k, v)
};

ObjectLiteralKey: EcoString = {
    <id: RawIdent> => EcoString::from(id),
    String => <>,
};

ObjectLiteralKVPair: (EcoString, ExprId) = {
    <k: ObjectLiteralKey> ":" <v: Expr> => (k, v),
    // Field shorthand: `{ a }` is `{ a: a }`.
    <l:@L> <id: RawIdent> <r:@R> => (
        EcoString::from(id),
        builder.alloc(ExprKind::Var(VarName::from(id)), Span::new(l as u32, r as u32)),
    ),
};

VarSet: EcoVec<VarName> = {
    "{" <vars: DelimitedSepListOpt<Ident, ",">> "}" => vars,
};

ExprList: EcoVec<ExprId> = {
    <items: DelimitedSepListOpt<Expr, ",">> => items
};

// A parameter's type may be left out when the context determines it.
LambdaParam: (VarName, Option<SourceType>) = {
    <name: Ident> <typ: TypeAnno?> => (name, typ),
}

TrailingComma: () = {
    => (),
    "," => (),
};

// -----------------------------------------------------------------------------
// Terminals / simple expressions
// -----------------------------------------------------------------------------

// Literal values mapped to syntax literals
LiteralVal: SyntaxLiteral = {
    MalformedFloat,
    Int => SyntaxLiteral::Int(<>),
    Float => SyntaxLiteral::Float(<>),
    Bool => SyntaxLiteral::Bool(<>),
    String => SyntaxLiteral::Str(<>),
    "(" ")" => SyntaxLiteral::Unit,
}

// Literal expression wrapper
SpannedLiteral: ExprId = MakeSpanned<Literal>;
Literal: ExprKind = {
    LiteralVal => ExprKind::Val(<>),
};

// Parenthesized expression
SpannedParen: ExprId = "(" <e:Expr> ")" => e;

// Identifier as an ExprKind (variable reference)
SpannedLowerVar: ExprId = MakeSpanned<LowerVarExprKind>;
LowerVarExprKind : ExprKind = {
    <name:LowerIdent> => ExprKind::Var(VarName::from(name)),
};

// A capitalised name is a variable only in a file that has not taken on
// tagged unions; expansion turns it into a constructor in one that has.
SpannedUpperVar: ExprId = MakeSpanned<UpperVarExprKind>;
UpperVarExprKind : ExprKind = {
    <name:UpperIdent> => ExprKind::Var(VarName::from(name)),
};

// Helpers for indexing base (literal, ident, or paren)
SIndexHelp: ExprId = {
    SpannedLiteral,
    SpannedLowerVar,
    SpannedUpperVar,
    SpannedParen
};

// Indexing expression e[idx]
SIndex: ExprId = {
  <l:@L> <expr: SIndexHelp> "[" <idx: Uint> "]" <r:@R> => {
        builder.alloc(ExprKind::SIndex(expr, idx), Span::new(l as u32, r as u32))
    },
};

// Container constructors
ContainerExpr: ExprId = {
  <l:@L> "[" <v:ExprList> "]" <r:@R> => {
        builder.alloc(ExprKind::List(v), Span::new(l as u32, r as u32))
    },
  <l:@L> "List" "(" <v:ExprList> ")" <r:@R> => {
        builder.alloc(ExprKind::List(v), Span::new(l as u32, r as u32))
    },
  <l:@L> "Tuple" "(" <v:ExprList> ")" <r:@R> => {
        builder.alloc(ExprKind::Tuple(v), Span::new(l as u32, r as u32))
    },
  <l:@L> "Map" "(" <kv_pairs: DelimitedSepListOpt<ExprKVPair, ",">> ")" <r:@R> => {
        builder.alloc(ExprKind::Map(kv_pairs.into()), Span::new(l as u32, r as u32))
    },
  <l:@L> "Struct" "(" <kv_pairs: DelimitedSepListOpt<ExprKVPair, ",">> ")" <r:@R> => {
        builder.alloc(ExprKind::Struct(kv_pairs.into()), Span::new(l as u32, r as u32))
    },
  <l:@L> "{" <kv_pairs: DelimitedSepListOpt<ObjectLiteralKVPair, ",">> "}" <r:@R> => {
        builder.alloc(ExprKind::ObjectLiteral(kv_pairs.into()), Span::new(l as u32, r as u32))
    }
}

// -----------------------------------------------------------------------------
// Special keywords / builtins (function-like forms)
// -----------------------------------------------------------------------------

SpecialKeywords: ExprId = {
  <l:@L> "dynamic" "(" <e: Expr> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "dynamic" "(" <e: Expr> <t: TypeAnno> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "dynamic" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "dynamic" "(" <e: Expr> <t: TypeAnno> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "eval" "(" <e: Expr> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "eval" "(" <e: Expr> <t: TypeAnno> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "eval" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "eval" "(" <e: Expr> <t: TypeAnno> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dynamic(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "defer" "(" <e: Expr> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Defer(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "defer" "(" <e: Expr> <t: TypeAnno> "," <vs: VarSet> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Defer(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Explicit(vs)), Span::new(l as u32, r as u32)),
  <l:@L> "defer" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Defer(e, StreamTypeAscription::Unascribed, ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "defer" "(" <e: Expr> <t: TypeAnno> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Defer(e, StreamTypeAscription::Ascribed(t), ReconfigurableExprScope::Automatic), Span::new(l as u32, r as u32)),
  <l:@L> "update" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Update(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "default" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Default(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "is_defined" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::IsDefined(e), Span::new(l as u32, r as u32)),
  <l:@L> "when" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::When(e), Span::new(l as u32, r as u32)),
  <l:@L> "latch" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Latch(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "init" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Init(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "List.get" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LIndex(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "List.concat" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LConcat(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "List.append" "(" <e1: Expr> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LAppend(e1, e2), Span::new(l as u32, r as u32)),
  <l:@L> "List.head" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LHead(e), Span::new(l as u32, r as u32)),
  <l:@L> "List.tail" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LTail(e), Span::new(l as u32, r as u32)),
  <l:@L> "List.len" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LLen(e), Span::new(l as u32, r as u32)),
  <l:@L> "List.map" "(" <f: Expr> "," <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LMap(f, e), Span::new(l as u32, r as u32)),
  <l:@L> "List.filter" "(" <f: Expr> "," <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LFilter(f, e), Span::new(l as u32, r as u32)),
  <l:@L> "List.fold" "(" <f: Expr> "," <init: Expr> "," <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::LFold(f, init, e), Span::new(l as u32, r as u32)),
  <l:@L> "fix" "(" <f: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Fix(f), Span::new(l as u32, r as u32)),
  <l:@L> "partial" "(" <f: Expr> <args:("," <Expr>)*> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Partial(f, args.into()), Span::new(l as u32, r as u32)),
  <l:@L> "Map.get" "(" <e: Expr> "," <k: String> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::MGet(e, k), Span::new(l as u32, r as u32)),
  <l:@L> "Map.remove" "(" <e: Expr> "," <k: String> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::MRemove(e, k), Span::new(l as u32, r as u32)),
  <l:@L> "Map.has_key" "(" <e: Expr> "," <k: String> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::MHasKey(e, k), Span::new(l as u32, r as u32)),
  <l:@L> "Map.insert" "(" <e1: Expr> "," <k: String> "," <e2: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::MInsert(e1, k, e2), Span::new(l as u32, r as u32)),
  <l:@L> "sin" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Sin(e), Span::new(l as u32, r as u32)),
  <l:@L> "cos" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Cos(e), Span::new(l as u32, r as u32)),
  <l:@L> "tan" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Tan(e), Span::new(l as u32, r as u32)),
  <l:@L> "abs" "(" <e: Expr> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Abs(e), Span::new(l as u32, r as u32)),
  <l:@L> "monitored_at" "(" <v: Ident> "," <n: PlacementNode> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::MonitoredAt(v, n), Span::new(l as u32, r as u32)),
  <l:@L> "dist" "(" <v1: VarOrNodeName> "," <v2: VarOrNodeName> <trailing:TrailingComma> ")" <r:@R> =>
       builder.alloc(ExprKind::Dist(v1, v2), Span::new(l as u32, r as u32)),
}

// -----------------------------------------------------------------------------
// Atom (base expressions with same precedence)
// -----------------------------------------------------------------------------

AtomBase: ExprId = {
    MatchExpr,
    MatchesExpr,
    SIndex,
    SpecialKeywords,
    SpannedLiteral,
    ContainerExpr,
    SpannedLowerVar,
    SpannedParen
}



// -----------------------------------------------------------------------------
// Match
// -----------------------------------------------------------------------------

// An arm contributes its guard, when it has one, then its body, so the node's
// children read in the order the arm was written.
MatchArmRule: (MatchArm, Option<ExprId>, ExprId) = {
    <pattern:Pattern> <guard:("if" <Expr>)?> "->" <body:Expr> =>
        (MatchArm { pattern, guarded: guard.is_some() }, guard, body),
};

MatchExpr: ExprId = {
    <l:@L> "match" "(" <scrutinee:Expr> ","? ")" "{" <arms:DelimitedSepListOpt<MatchArmRule, ",">> "}" <r:@R> => {
        let mut shape = EcoVec::new();
        let mut children = EcoVec::new();
        for (arm, guard, body) in arms {
            if let Some(guard) = guard {
                children.push(guard);
            }
            children.push(body);
            shape.push(arm);
        }
        builder.alloc(ExprKind::Match(scrutinee, children, shape), Span::new(l as u32, r as u32))
    },
};

MatchesExpr: ExprId = {
    <l:@L> "matches" "(" <scrutinee:Expr> "," <pattern:Pattern> <guard:("if" <Expr>)?> ","? ")" <r:@R> =>
        builder.alloc(
            ExprKind::Matches(scrutinee, guard.into_iter().collect(), pattern),
            Span::new(l as u32, r as u32),
        ),
};

// -----------------------------------------------------------------------------
// Patterns
// -----------------------------------------------------------------------------

// Alternatives of an or-pattern. A single alternative is the pattern itself,
// so `p | q` is the only thing that builds an `Or`.
Pattern: MatchPattern = {
    <l:@L> <first:PatternPrimary> <rest:("|" <PatternPrimary>)*> <r:@R> => {
        if rest.is_empty() {
            first
        } else {
            let mut alternatives = EcoVec::from([first]);
            alternatives.extend(rest);
            MatchPattern::new(PatternKind::Or(alternatives), Span::new(l as u32, r as u32))
        }
    },
};

PatternField: (EcoString, MatchPattern) = {
    <name:RawIdent> ":" <pattern:Pattern> => (name.into(), pattern),
    // Field shorthand: `{ a }` binds the field to its own name.
    <l:@L> <name:LowerIdent> <r:@R> => (
        name.into(),
        MatchPattern::new(PatternKind::Bind(VarName::from(name)), Span::new(l as u32, r as u32)),
    ),
};

// `{ a: p, .. }` names the fields it cares about; without `..` it names them
// all.
PatternFields: (EcoVec<(EcoString, MatchPattern)>, bool) = {
    ".." ","? => (EcoVec::new(), true),
    <mut fields:(<PatternField> ",")*> <field:PatternField> "," ".." ","? => {
        fields.push(field);
        (fields.into(), true)
    },
    <fields:DelimitedSepListOpt<PatternField, ",">> => (fields, false),
};

PatternInt: i64 = {
    <value:Int> => value,
    "-" <value:Int> => -value,
};

PatternPrimary: MatchPattern = {
    <l:@L> <kind:PatternKindRule> <r:@R> => MatchPattern::new(kind, Span::new(l as u32, r as u32)),
};

PatternKindRule: PatternKind = {
    // `_` binds nothing; any other lower-case name binds the value.
    <name:LowerIdent> => if name == "_" {
        PatternKind::Wildcard
    } else {
        PatternKind::Bind(VarName::from(name))
    },
    <name:LowerIdent> "@" <inner:PatternPrimary> =>
        PatternKind::As(VarName::from(name), Box::new(inner)),
    <tag:UpperIdent> => PatternKind::Tag { tag: tag.into(), payload: None },
    <tag:UpperIdent> "(" <payload:Pattern> ","? ")" =>
        PatternKind::Tag { tag: tag.into(), payload: Some(Box::new(payload)) },
    "(" <mut first:(<Pattern> ",")+> <last:Pattern?> ")" => {
        if let Some(last) = last {
            first.push(last);
        }
        PatternKind::Tuple(first.into())
    },
    "[" <items:DelimitedSepListOpt<Pattern, ",">> "]" => PatternKind::List(items),
    "{" <fields:PatternFields> "}" =>
        PatternKind::Struct { fields: fields.0, rest: fields.1 },
    <value:PatternInt> => PatternKind::Literal(SyntaxLiteral::Int(value)),
    <start:PatternInt> ".." <end:PatternInt> =>
        PatternKind::Range { start, end, inclusive: false },
    <start:PatternInt> "..=" <end:PatternInt> =>
        PatternKind::Range { start, end, inclusive: true },

    <value:String> => PatternKind::Literal(SyntaxLiteral::Str(value)),
    <value:Bool> => PatternKind::Literal(SyntaxLiteral::Bool(value)),
    "(" ")" => PatternKind::Literal(SyntaxLiteral::Unit),
    <l:@L> <_value:Float> =>? {
        *user_error_location = Some(l);
        Err(ParseError::User { error: "a Float is not a pattern: compare it with an operator instead" })
    },
};

// A constructor names its tag, and the union it belongs to when the writer
// qualifies it. Parsing knows no schema: which union a tag belongs to, and
// which alternative it selects, is settled when the expression is elaborated.
UnionConstructor: ExprId = {
    <l:@L> <qualifier:SourceName> "::" <tag:RawIdent> <r:@R> =>
        builder.alloc(ExprKind::Constructor(EcoVec::new(), tag.into(), Some(qualifier)), Span::new(l as u32, r as u32)),
    <l:@L> <qualifier:SourceName> "::" <tag:RawIdent> "(" <payload:Expr> <trailing:TrailingComma> ")" <r:@R> =>
        builder.alloc(ExprKind::Constructor(EcoVec::from([payload]), tag.into(), Some(qualifier)), Span::new(l as u32, r as u32)),
    <l:@L> <tag:UpperIdent> "(" <payload:Expr> <trailing:TrailingComma> ")" <r:@R> =>
        builder.alloc(ExprKind::Constructor(EcoVec::from([payload]), tag.into(), None), Span::new(l as u32, r as u32)),
};

FieldName: EcoString = {
    <field: RawIdent> => field.into(),
    <idx: Uint> => idx.to_string().into(),
}

// Calls and field accesses allocate each prefix immediately, preserving postorder
// construction and giving every generated node its exact source span.
//
// A constructor is not a function, so it never heads a call: in
// `Tag(payload)` the parentheses belong to the constructor, which is why the
// callee of a call is a `CallableAtom` rather than any atom.
CallableAtom: ExprId = {
    AtomBase,
    <base: CallableAtom> "(" <args: DelimitedSepListOpt<Expr, ",">> ")" <r:@R> => {
        let start = builder.metadata(base).start;
        builder.alloc(ExprKind::Apply(base, args), Span::new(start, r as u32))
    },
    <base: Atom> "." <field: FieldName> <r:@R> => {
        let start = builder.metadata(base).start;
        builder.alloc(ExprKind::SGet(base, field), Span::new(start, r as u32))
    },
}

Atom: ExprId = {
    CallableAtom,
    UnionConstructor,
    SpannedUpperVar,
}

// -----------------------------------------------------------------------------
// Unary expressions
// -----------------------------------------------------------------------------

UnaryExpr: ExprId = {
   <l:@L> "-" <x: UnaryExpr> <r:@R> => {
        builder.alloc(ExprKind::Neg(x), Span::new(l as u32, r as u32))
   },
   <l:@L> "!" <b: UnaryExpr> <r:@R> => {
        builder.alloc(ExprKind::Not(b), Span::new(l as u32, r as u32))
    },
   <l:@L> "not" <b: UnaryExpr> <r:@R> => {
        builder.alloc(ExprKind::Not(b), Span::new(l as u32, r as u32))
    },
    PowerExpr
};

PowerExpr: ExprId = {
    <l:@L> <lhs:Atom> "**" <rhs:UnaryExpr> <r:@R> =>
        builder.alloc(ExprKind::BinOp(lhs, rhs, BinaryOperator::Power), Span::new(l as u32, r as u32)),
    Atom,
};

// -----------------------------------------------------------------------------
// Binary operators
// -----------------------------------------------------------------------------

// Multiplicative helpers
MultExprHelp: BinaryOperator  = {
    "*" => BinaryOperator::Multiply,
    "/" => BinaryOperator::Divide,
    "%" => BinaryOperator::Modulo,
};

MultExpr<Next>: ExprId = {
  <l:@L>  <lhs: MultExpr<Next>> <op: MultExprHelp> <rhs: Next> <r:@R> => {
    builder.alloc(ExprKind::BinOp(lhs, rhs, op), Span::new(l as u32, r as u32))
    },
    Next
};

// Additive helpers
AddExprHelp: BinaryOperator  = {
    "+" => BinaryOperator::Add,
    "-" => BinaryOperator::Subtract,
};

AddExpr<Next>: ExprId = {
   <l:@L> <lhs: AddExpr<Next>> <op: AddExprHelp> <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, op), Span::new(l as u32, r as u32))
    },
    Next
};

// Relational operators ( < <= > >= )
RelExprHelp: BinaryOperator = {
    "<=" => BinaryOperator::LessEqual,
    ">=" => BinaryOperator::GreaterEqual,
    "<" => BinaryOperator::Less,
    ">" => BinaryOperator::Greater,
}

RelExpr<Next>: ExprId ={
  <l:@L>  <lhs: RelExpr<Next>> <op: RelExprHelp> <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, op), Span::new(l as u32, r as u32))
    },
    Next
};

// Comparison (==)
CompExprHelp: BinaryOperator = {
    "==" => BinaryOperator::Equal,
    "!=" => BinaryOperator::NotEqual,
}

CompExpr<Next>: ExprId = {
   <l:@L> <lhs: CompExpr<Next>> <op: CompExprHelp> <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, op), Span::new(l as u32, r as u32))
    },
    Next
};

// Boolean
AndExprHelp: () = {
    "&&" => (),
    "and" => (),
};

AndExpr<Next>: ExprId = {
  <l:@L>  <lhs: AndExpr<Next>> <_op:AndExprHelp> <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, BinaryOperator::And), Span::new(l as u32, r as u32))
    },
    Next
};

OrExprHelp: () = {
    "||" => (),
    "or" => (),
};

OrExpr<Next>: ExprId = {
   <l:@L> <lhs: OrExpr<Next>> <_op:OrExprHelp> <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, BinaryOperator::Or), Span::new(l as u32, r as u32))
    },
    Next
};

ImplExpr<Next>: ExprId = {
   <l:@L> <lhs: ImplExpr<Next>> "=>" <rhs: Next> <r:@R> => {
        builder.alloc(ExprKind::BinOp(lhs, rhs, BinaryOperator::Implication), Span::new(l as u32, r as u32))
    },
    Next
};

// String concat
ConcatExpr<Next>: ExprId = {
   <l:@L> <lhs: ConcatExpr<Next>> "++" <rhs: Next> <r:@R> => {
                builder.alloc(ExprKind::BinOp(lhs, rhs, BinaryOperator::Concatenate), Span::new(l as u32, r as u32))
    },
    Next
}

// -----------------------------------------------------------------------------
// If-then-else (binds weaker than the precedence chain)
// -----------------------------------------------------------------------------

Ifelse: ExprId = {
   <l:@L>  "if" <c: Expr> "then" <i: Expr> "else" <e: Expr> <r:@R> => {
    builder.alloc(ExprKind::If(c, i, e), Span::new(l as u32, r as u32))
   }
}

LambdaExpr: ExprId = {
   <l:@L> "\\" <params: SepList<LambdaParam, ",">> "->" <body: Expr> <r:@R> => {
    builder.alloc(ExprKind::Lambda(params, body), Span::new(l as u32, r as u32))
   }
}

// -----------------------------------------------------------------------------
// Types / annotations
// -----------------------------------------------------------------------------

StructTypeField: (EcoString, SourceType) = {
    <name: RawIdent> ":" <typ: StreamTyp> => (name.into(), typ),
    <name: String> ":" <typ: StreamTyp> => (name, typ),
}

StructPermissiveFields: EcoVec<(EcoString, SourceType)> = {
    "..." ","? => EcoVec::new(),
    <mut fields:(<StructTypeField> ",")*> <field: StructTypeField> "," "..." ","? => {
        fields.push(field);
        fields.into()
    },
}

// One alternative of a `Union<…>` type: a tag, and a payload type when it
// carries one.
UnionAlternative: SourceAlternative = {
    <l:@L> <tag:RawIdent> <payload:TypeAnno?> <r:@R> => SourceAlternative {
        tag: tag.into(), payload, span: Span::new(l as u32, r as u32),
    },
};

SourceName: TypeName = <l:@L> <name:RawIdent> =>? TypeName::new(name).map_err(|_| {
    *user_error_location = Some(l);
    ParseError::User { error: "invalid or reserved type alias name" }
});

StreamTyp: SourceType = {
    <l:@L> <kind:StreamTypKind> <r:@R> => SourceType { kind, span: Span::new(l as u32, r as u32) },
};

StreamTypKind: StreamType = {
    <name:SourceName> => StreamType::Named(name, EcoVec::new()),
    <name:SourceName> "<" <arguments:DelimitedSepListOpt<StreamTyp, ",">> ">" =>
        StreamType::Named(name, arguments),
    "Int" => StreamType::Int,
    "Str" => StreamType::Str,
    "Float" => StreamType::Float,
    "Bool" => StreamType::Bool,
    "Unit" => StreamType::Unit,
    "Any" => StreamType::Any,
    "List" "<" <inner: StreamTyp> ","? ">" => StreamType::List(Box::new(inner)),
    "Map" "<" <inner: StreamTyp> ","? ">" => StreamType::Map(Box::new(inner)),
    "Expr" "<" <inner: StreamTyp> ","? ">" => StreamType::Expr(Box::new(inner)),
    "Union" "<" <alternatives:DelimitedSepListOpt<UnionAlternative, ",">> ">" => StreamType::Union(alternatives),
    "Struct" "<" <fields: StructPermissiveFields> ">" => StreamType::Struct(fields, true),
    "Struct" "<" <fields: DelimitedSepListOpt<StructTypeField, ",">> ">" => StreamType::Struct(fields, false),
    "(" <first: StreamTyp> "," ")" => {
        let mut elems = EcoVec::new();
        elems.push(first);
        StreamType::Tuple(elems)
    },
    "(" <first: StreamTyp> "," <second: StreamTyp> <rest:("," <StreamTyp>)*> ","? ")" => {
        let mut elems = EcoVec::new();
        elems.push(first);
        elems.push(second);
        elems.extend(rest);
        StreamType::Tuple(elems)
    },
    "(" <arg: StreamTyp> "->" <ret: StreamTyp> ")" => {
        StreamType::Function(EcoVec::from(vec![arg]), Box::new(ret))
    },
}

TypeAnno: SourceType = {
    ":" <StreamTyp> => <>
}

// -----------------------------------------------------------------------------
// Precedence chain: compose operator precedence from lowest → highest
// -----------------------------------------------------------------------------

// Operator precedence chain with Final having highest precedence
PrecChain: ExprId = {
    ConcatExpr<ImplExpr<OrExpr<AndExpr<CompExpr<RelExpr<AddExpr<MultExpr<UnaryExpr>>>>>>>>,
}

// The top-level expression
pub Expr: ExprId = {
    Ifelse, // If-else binds weaker than the PrecChain chain to handle dangling else, i.e., if a then b else c + d is parsed as if a then b else (c + d)
    LambdaExpr,
    PrecChain
};

// -----------------------------------------------------------------------------
// Top-level declarations
// -----------------------------------------------------------------------------

InputDecl: Declaration = {
   <l:@L> "in" <id: Ident> <typ: TypeAnno?> <r:@R>=>
   Declaration::Input(id, typ, Span::new(l as u32, r as u32))
};

// A stream may be defined on its declaration line: `out x: T = e`.
Definition: ExprId = {
   "=" <Expr>
};

OutputDecl: Declaration = {
   <l:@L> "out" <id: Ident> <typ: TypeAnno?> <def: Definition?> <r:@R> => Declaration::Output(id, typ, def, Span::new(l as u32, r as u32)),
};

AuxDecl: Declaration = {
   <l:@L> "aux" <id: Ident> <typ: TypeAnno?> <def: Definition?> <r:@R> => Declaration::Aux(id, typ, def, Span::new(l as u32, r as u32)),
   <l:@L> "var" <id: Ident> <typ: TypeAnno?> <def: Definition?> <r:@R> => Declaration::Aux(id, typ, def, Span::new(l as u32, r as u32)),
};

Equation: Declaration = {
   <l:@L> <var: Ident> "=" <expr: Expr> <r:@R> => Declaration::Equation(var, expr, Span::new(l as u32, r as u32))
}

// Type parameters are capitalised like any other type name, and are in
// scope only inside the alias they belong to.
AliasParameters: EcoVec<TypeName> = {
    "<" <parameters:DelimitedSepListOpt<SourceName, ",">> ">" => parameters,
};

AliasDecl: Declaration = {
   <l:@L> "type" <name:SourceName> <parameters:AliasParameters?> "=" <ty:StreamTyp> <r:@R> =>
       Declaration::Alias(AliasDeclaration {
           name,
           parameters: parameters.unwrap_or_else(EcoVec::new),
           ty,
           span: Span::new(l as u32, r as u32),
       }),
}

// Header declarations. Their keywords are reserved everywhere; the names
// they take are checked by the expansion stage.
EditionDigits: &'input str = <s:r"[0-9]+"> => s;

HeaderItem: (EcoString, Span) = {
   <l:@L> <name:RawIdent> <r:@R> => (EcoString::from(name), Span::new(l as u32, r as u32)),
};

HeaderDecl: Declaration = {
   <l:@L> "language" <name:RawIdent> <r:@R> =>
       Declaration::Language(EcoString::from(name), Span::new(l as u32, r as u32)),
   <l:@L> "edition" <year:EditionDigits> "-" <month:EditionDigits> <r:@R> =>
       Declaration::Edition(EcoString::from(format!("{year}-{month}")), Span::new(l as u32, r as u32)),
   <l:@L> "use" <namespace:RawIdent> "::" "{" <items:SepList<HeaderItem, ",">> "}" <r:@R> =>
       Declaration::Use { namespace: EcoString::from(namespace), items: Some(items), span: Span::new(l as u32, r as u32) },
   <l:@L> "use" <namespace:RawIdent> "::" "*" <r:@R> =>
       Declaration::Use { namespace: EcoString::from(namespace), items: None, span: Span::new(l as u32, r as u32) },
};

Declaration: Declaration = {
    HeaderDecl,
    InputDecl,
    OutputDecl,
    AuxDecl,
    AliasDecl,
    Equation
}

pub Declarations: EcoVec<Declaration> = {
   Declaration* => <>.into()
}
