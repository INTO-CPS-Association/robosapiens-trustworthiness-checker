in iMap: Map<Int>
out oMap: Map<Int>
out nestedMap: Map<Map<Int>>
out mapGet: Int
out mapRemove: Map<Int>
out mapInsert: Map<Int>
out mapHasKey: Bool
oMap = iMap
nestedMap = Map("a": iMap, "b": iMap)
mapGet = Map.get(iMap, "x")
mapRemove = Map.remove(iMap, "x")
mapInsert = Map.insert(iMap, "z", 42)
mapHasKey = Map.has_key(iMap, "x")
