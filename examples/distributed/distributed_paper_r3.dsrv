// Run with:
// cargo run --profile dev-fast --features ros -- examples/distributed/distributed_paper_r3.dsrv --input-ros-file examples/distributed/distributed_paper_r3_map.json

in R3Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>

in ConveyorSystem: Int
in StackerCrane: Int
in VerticalLift: Int
in HorizontalCarousel: Int

out CS3Alert: Int
out SC3Alert: Int
out VL3Alert: Int
out HC3Alert: Int

// Axis-aligned bounding box (AABB) of RX and Machine Y
out aabbR3C: Bool
out aabbR3S: Bool
out aabbR3V: Bool
out aabbR3H: Bool

// Robot positions
aux R3Pose: Struct<x: Float, y: Float, ...>
aux R3X: Float
aux R3Y: Float

// Machine static coords:
aux CX: Float
aux CY: Float
aux SX: Float
aux SY: Float
aux VX: Float
aux VY: Float
aux HX: Float
aux HY: Float

// AABB constant
aux D: Float

aux CPred: Bool
aux SPred: Bool
aux VPred: Bool
aux HPred: Bool

// Extract the position of Robots from odometry data
R3Pose = R3Odom.pose.pose.position
R3X = R3Pose.x
R3Y = R3Pose.y

// Coordinates of machines (static)
CX = 3.5
CY = 3.0
SX = 3.5
SY = -6.0
VX = -4.0
VY = -6.0
HX = -4.0
HY = 3.0

// Bounding box = 10 units wide = robot is maximum five units away from center
D = 5.0 // Or 10.0 / 2.0

// Probabilistic predicates for machine states:
CPred = ConveyorSystem < 0
SPred = StackerCrane < 0 && StackerCrane > 30
VPred = VerticalLift > 100
HPred = HorizontalCarousel == 0

// AABB for circles. Esentially (with subst. values):
// -1.5 <= x <= 8.5 && -2.0 <= y <= 8.0 for ConveyorSystem
aabbR3C = abs(R3X - CX) <= D && abs(R3Y - CY) <= D 

aabbR3S = abs(R3X - SX) <= D && abs(R3Y - SY) <= D 

aabbR3V = abs(R3X - VX) <= D && abs(R3Y - VY) <= D 

aabbR3H = abs(R3X - HX) <= D && abs(R3Y - HY) <= D 

CS3Alert = if aabbR3C then if CPred then 1 else 0 else -1
SC3Alert = if aabbR3S then if SPred then 1 else 0 else -1
VL3Alert = if aabbR3V then if VPred then 1 else 0 else -1
HC3Alert = if aabbR3H then if HPred then 1 else 0 else -1
