// Run with:
// cargo run --profile dev-fast --features ros -- examples/distributed/distributed_paper_r2.dsrv --input-ros-file examples/distributed/distributed_paper_r2_map.json

in R2Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>

in ConveyorSystem: Int
in StackerCrane: Int
in VerticalLift: Int
in HorizontalCarousel: Int

out CS2Alert: Int
out SC2Alert: Int
out VL2Alert: Int
out HC2Alert: Int

// Axis-aligned bounding box (AABB) of RX and Machine Y
out aabbR2C: Bool
out aabbR2S: Bool
out aabbR2V: Bool
out aabbR2H: Bool

// Robot positions
aux R2Pose: Struct<x: Float, y: Float, ...>
aux R2X: Float
aux R2Y: Float

// Machine static coords:
aux CX: Float
aux CY: Float
aux SX: Float
aux SY: Float
aux VX: Float
aux VY: Float
aux HX: Float
aux HY: Float

// AABB constant
aux D: Float

aux CPred: Bool
aux SPred: Bool
aux VPred: Bool
aux HPred: Bool

// Extract the position of Robots from odometry data
R2Pose = R2Odom.pose.pose.position
R2X = R2Pose.x
R2Y = R2Pose.y

// Coordinates of machines (static)
CX = 3.5
CY = 3.0
SX = 3.5
SY = -6.0
VX = -4.0
VY = -6.0
HX = -4.0
HY = 3.0

// Bounding box = 10 units wide = robot is maximum five units away from center
D = 5.0 // Or 10.0 / 2.0

// Probabilistic predicates for machine states:
CPred = ConveyorSystem < 0
SPred = StackerCrane < 0 && StackerCrane > 30
VPred = VerticalLift > 100
HPred = HorizontalCarousel == 0

// AABB for circles. Esentially (with subst. values):
// -1.5 <= x <= 8.5 && -2.0 <= y <= 8.0 for ConveyorSystem
aabbR2C = abs(R2X - CX) <= D && abs(R2Y - CY) <= D 

aabbR2S = abs(R2X - SX) <= D && abs(R2Y - SY) <= D 

aabbR2V = abs(R2X - VX) <= D && abs(R2Y - VY) <= D 

aabbR2H = abs(R2X - HX) <= D && abs(R2Y - HY) <= D 

CS2Alert = if aabbR2C then if CPred then 1 else 0 else -1
SC2Alert = if aabbR2S then if SPred then 1 else 0 else -1
VL2Alert = if aabbR2V then if VPred then 1 else 0 else -1
HC2Alert = if aabbR2H then if HPred then 1 else 0 else -1
