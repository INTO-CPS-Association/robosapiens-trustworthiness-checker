language distributed

// Run with:
// RUST_LOG=INFO cargo run --features ros -- examples/distributed/not_working.dsrv --runtime distributed --distribution-graph examples/distributed/not_working_graph.json --distribution-constraints distR1 --dist-constraint-solver sat --scheduling-mode ros --scheduler-ros-node-name tc_scheduler_main --scheduler-reconf-topic reconfig --input-ros-file examples/distributed/not_working_map.json --output-ros-file examples/distributed/not_working_out_map.json
// Notice that R1Odom, etc is lost

in c: Bool

in R1Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>
in R2Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>
in R3Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>
in R4Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, ...>, ...>, ...>, ...>

in ConveyorSystem: Int
in StackerCrane: Int
in VerticalLift: Int
in HorizontalCarousel: Int

out CS1Alert: Int
out CS2Alert: Int
out CS3Alert: Int
out CS4Alert: Int
out SC1Alert: Int
out SC2Alert: Int
out SC3Alert: Int
out SC4Alert: Int
out VL1Alert: Int
out VL2Alert: Int
out VL3Alert: Int
out VL4Alert: Int
out HC1Alert: Int
out HC2Alert: Int
out HC3Alert: Int
out HC4Alert: Int

// Axis-aligned bounding box (AABB) of RX and Machine Y
out aabbR1C: Bool
out aabbR2C: Bool
out aabbR3C: Bool
out aabbR4C: Bool
out aabbR1S: Bool
out aabbR2S: Bool
out aabbR3S: Bool
out aabbR4S: Bool
out aabbR1V: Bool
out aabbR2V: Bool
out aabbR3V: Bool
out aabbR4V: Bool
out aabbR1H: Bool
out aabbR2H: Bool
out aabbR3H: Bool
out aabbR4H: Bool

// Dist constraints
out distR1: Bool

// Robot positions
aux R1Pose: Struct<x: Float, y: Float, ...>
aux R1X: Float
aux R1Y: Float
aux R2Pose: Struct<x: Float, y: Float, ...>
aux R2X: Float
aux R2Y: Float
aux R3Pose: Struct<x: Float, y: Float, ...>
aux R3X: Float
aux R3Y: Float
aux R4Pose: Struct<x: Float, y: Float, ...>
aux R4X: Float
aux R4Y: Float

// Machine static coords:
aux CX: Float
aux CY: Float
aux SX: Float
aux SY: Float
aux VX: Float
aux VY: Float
aux HX: Float
aux HY: Float

// AABB constant
aux D: Float

aux CPred: Bool
aux SPred: Bool
aux VPred: Bool
aux HPred: Bool

// Extract the position of Robots from odometry data
R1Pose = R1Odom.pose.pose.position
R1X = R1Pose.x
R1Y = R1Pose.y
R2Pose = R2Odom.pose.pose.position
R2X = R2Pose.x
R2Y = R2Pose.y
R3Pose = R3Odom.pose.pose.position
R3X = R3Pose.x
R3Y = R3Pose.y
R4Pose = R4Odom.pose.pose.position
R4X = R4Pose.x
R4Y = R4Pose.y

// Coordinates of machines (static)
CX = 3.5
CY = 3.0
SX = 3.5
SY = -6.0
VX = -4.0
VY = -6.0
HX = -4.0
HY = 3.0

// Bounding box = 10 units wide = robot is maximum five units away from center
D = 5.0 // Or 10.0 / 2.0

// Probabilistic predicates for machine states:
CPred = ConveyorSystem < 0
SPred = StackerCrane < 0 && StackerCrane > 30
VPred = VerticalLift > 100
HPred = HorizontalCarousel == 0

// AABB for circles. Esentially (with subst. values):
// -1.5 <= x <= 8.5 && -2.0 <= y <= 8.0 for ConveyorSystem
aabbR1C = abs(R1X - CX) <= D && abs(R1Y - CY) <= D 
aabbR2C = abs(R2X - CX) <= D && abs(R2Y - CY) <= D
aabbR3C = abs(R3X - CX) <= D && abs(R3Y - CY) <= D
aabbR4C = abs(R4X - CX) <= D && abs(R4Y - CY) <= D

aabbR1S = abs(R1X - SX) <= D && abs(R1Y - SY) <= D 
aabbR2S = abs(R2X - SX) <= D && abs(R2Y - SY) <= D
aabbR3S = abs(R3X - SX) <= D && abs(R3Y - SY) <= D
aabbR4S = abs(R4X - SX) <= D && abs(R4Y - SY) <= D

aabbR1V = abs(R1X - VX) <= D && abs(R1Y - VY) <= D 
aabbR2V = abs(R2X - VX) <= D && abs(R2Y - VY) <= D
aabbR3V = abs(R3X - VX) <= D && abs(R3Y - VY) <= D
aabbR4V = abs(R4X - VX) <= D && abs(R4Y - VY) <= D

aabbR1H = abs(R1X - HX) <= D && abs(R1Y - HY) <= D 
aabbR2H = abs(R2X - HX) <= D && abs(R2Y - HY) <= D
aabbR3H = abs(R3X - HX) <= D && abs(R3Y - HY) <= D
aabbR4H = abs(R4X - HX) <= D && abs(R4Y - HY) <= D

CS1Alert = if aabbR1C then if CPred then 1 else 0 else -1
CS2Alert = if aabbR2C then if CPred then 1 else 0 else -1
CS3Alert = if aabbR3C then if CPred then 1 else 0 else -1
CS4Alert = if aabbR4C then if CPred then 1 else 0 else -1
SC1Alert = if aabbR1S then if SPred then 1 else 0 else -1
SC2Alert = if aabbR2S then if SPred then 1 else 0 else -1
SC3Alert = if aabbR3S then if SPred then 1 else 0 else -1
SC4Alert = if aabbR4S then if SPred then 1 else 0 else -1
VL1Alert = if aabbR1V then if VPred then 1 else 0 else -1
VL2Alert = if aabbR2V then if VPred then 1 else 0 else -1
VL3Alert = if aabbR3V then if VPred then 1 else 0 else -1
VL4Alert = if aabbR4V then if VPred then 1 else 0 else -1
HC1Alert = if aabbR1H then if HPred then 1 else 0 else -1
HC2Alert = if aabbR2H then if HPred then 1 else 0 else -1
HC3Alert = if aabbR3H then if HPred then 1 else 0 else -1
HC4Alert = if aabbR4H then if HPred then 1 else 0 else -1

distR1 =  if c
         then monitored_at(CS1Alert, A) && monitored_at(aabbR1C, A)
         else monitored_at(CS1Alert, B) && monitored_at(aabbR1C, B)
