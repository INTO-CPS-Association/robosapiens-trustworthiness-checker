in iList: List<Int>
out oList: List<Int>
out nestedList: List<List<Int>>
out listIndex: Int
out listAppend: List<Int>
out listConcat: List<Int>
out listHead: Int
out listTail: List<Int>
oList = iList
nestedList = List(iList, iList)
listIndex = List.get(iList, 0)
listAppend = List.append(iList, (1+1)/2)
listConcat = List.concat(iList, iList)
listHead = List.head(iList)
listTail = List.tail(iList)
