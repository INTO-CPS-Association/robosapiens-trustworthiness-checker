type BodyPart = Struct<x: Float, y: Float, z: Float, p_2: Float, ...>
type Human = Struct<human_id: Int, body_parts: List<BodyPart>, ...>

in rawHuman: Struct<humans: List<Human>, time: Float, ...>
out rForearmVelX: Float
out rForearmVelY: Float
out rForearmVelZ: Float
out rForearmRealisticVel: Bool
out hasHumansCp: Bool

out DSUAllowed: Bool

aux humans: List<Human>
aux hasHumans: Bool
aux hasHumansPrev4: Bool
aux human0: Human
aux humanId: Int
aux bodyParts: List<BodyPart>
aux time: Float
aux dt: Float

aux head: BodyPart
aux neck: BodyPart
aux torso: BodyPart
aux rShoulder: BodyPart
aux rUpperArm: BodyPart
aux rElbow: BodyPart
aux rForearm: BodyPart
aux rHand: BodyPart
aux lShoulder: BodyPart
aux lUpperArm: BodyPart
aux lElbow: BodyPart
aux lForearm: BodyPart
aux lHand: BodyPart
aux rHip: BodyPart
aux rThigh: BodyPart
aux rKnee: BodyPart
aux rLowerLeg: BodyPart
aux rFoot: BodyPart
aux lHip: BodyPart
aux lThigh: BodyPart
aux lKnee: BodyPart
aux lLowerLeg: BodyPart
aux lFoot: BodyPart

// Forearm aux
aux forearmSymEps: Float
aux forearmSymmetry: Bool
aux rForearmHeight: Float
aux rForearmHeightSmooth: Float
aux rForearmDiff: Float
aux rForearmDiffSmooth: Float
aux lForearmHeight: Float
aux lForearmHeightSmooth: Float
aux lForearmDiff: Float
aux lForearmDiffSmooth: Float
aux rForearmConstantLength: Bool
aux lForearmConstantLength: Bool

// Forarm velocity
aux rForearmX: Float
aux rForearmY: Float
aux rForearmZ: Float

humans = rawHuman.humans
hasHumans = List.len(humans) > 0
hasHumansPrev4 = update(false, hasHumans[1]) && update(false, hasHumans[2]) && update(false, hasHumans[3]) && update(false, hasHumans[4])
human0 = if hasHumans then List.get(humans, 0) else {human_id: -1, body_parts: List()}
humanId = if hasHumans then human0.human_id else -1
bodyParts = if hasHumans then human0.body_parts else List()
time = rawHuman.time
dt = time - time[1]

head = if hasHumans then List.get(bodyParts, 0) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
neck = if hasHumans then List.get(bodyParts, 1) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
torso = if hasHumans then List.get(bodyParts, 2) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rShoulder = if hasHumans then List.get(bodyParts, 3) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rUpperArm = if hasHumans then List.get(bodyParts, 4) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rElbow = if hasHumans then List.get(bodyParts, 5) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rForearm = if hasHumans then List.get(bodyParts, 6) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rHand = if hasHumans then List.get(bodyParts, 7) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lShoulder = if hasHumans then List.get(bodyParts, 8) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lUpperArm = if hasHumans then List.get(bodyParts, 9) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lElbow = if hasHumans then List.get(bodyParts, 10) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lForearm = if hasHumans then List.get(bodyParts, 11) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lHand = if hasHumans then List.get(bodyParts, 12) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rHip = if hasHumans then List.get(bodyParts, 13) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rThigh = if hasHumans then List.get(bodyParts, 14) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rKnee = if hasHumans then List.get(bodyParts, 15) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rLowerLeg = if hasHumans then List.get(bodyParts, 16) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
rFoot = if hasHumans then List.get(bodyParts, 17) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lHip = if hasHumans then List.get(bodyParts, 18) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lThigh = if hasHumans then List.get(bodyParts, 19) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lKnee = if hasHumans then List.get(bodyParts, 20) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lLowerLeg = if hasHumans then List.get(bodyParts, 21) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}
lFoot = if hasHumans then List.get(bodyParts, 22) else {x: 0.0, y: 0.0, z: 0.0, p_2: 0.0}

// Forearm symmetry check
forearmSymEps = 0.1
rForearmHeight = if hasHumans then rForearm.p_2 else -1.0
lForearmHeight = if hasHumans then lForearm.p_2 else -1.0
forearmSymmetry = if hasHumans then abs(rForearmHeight - lForearmHeight) < forearmSymEps else true

// Smooth forearm height - averaged over 4 samples
rForearmHeightSmooth = if hasHumansPrev4 then update(0.0, rForearmHeightSmooth[1]) + (rForearmHeight - update(0.0, rForearmHeight[4])) / 4 else update(0.0, rForearmHeightSmooth[1])
lForearmHeightSmooth = if hasHumansPrev4 then update(0.0, lForearmHeightSmooth[1]) + (lForearmHeight - update(0.0, lForearmHeight[4])) / 4 else update(0.0, lForearmHeightSmooth[1])

// Forearm constant bone length:
rForearmDiff = if hasHumans then update(0.0, rForearmHeight - rForearmHeight[1]) else update(0.0, rForearmDiff[1])
rForearmDiffSmooth = if hasHumans then update(0.0, rForearmHeightSmooth - rForearmHeightSmooth[1]) else update(0.0, rForearmDiffSmooth[1])
rForearmConstantLength = abs(rForearmDiff) < 0.1 && abs(rForearmDiffSmooth) < 0.1
lForearmDiff = if hasHumans then update(0.0, lForearmHeight - lForearmHeight[1]) else update(0.0, lForearmDiff[1])
lForearmDiffSmooth = if hasHumans then update(0.0, lForearmHeightSmooth - lForearmHeightSmooth[1]) else update(0.0, lForearmDiffSmooth[1])
lForearmConstantLength = abs(lForearmDiff) < 0.1 && abs(lForearmDiffSmooth) < 0.1

// Forearm Velocity:
rForearmX = if hasHumans then rForearm.x else update(0.0, rForearmX[1])
rForearmY = if hasHumans then rForearm.y else update(0.0, rForearmY[1])
rForearmZ = if hasHumans then rForearm.z else update(0.0, rForearmZ[1])
rForearmVelX = update(0.0, (rForearmX - rForearmX[1]) / dt)
rForearmVelY = update(0.0, (rForearmY - rForearmY[1]) / dt)
rForearmVelZ = update(0.0, (rForearmZ - rForearmZ[1]) / dt)
rForearmRealisticVel = abs(rForearmVelX) < 0.01 && abs(rForearmVelY) < 0.01 && abs(rForearmVelZ) < 0.01

DSUAllowed = !hasHumans

hasHumansCp = hasHumans

// Next steps:
// Max Velocity of arms
// Allow changing the diff - with an absolute truth instead - refinement pattern
