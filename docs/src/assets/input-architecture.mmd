flowchart TB
    accTitle: Input source ownership and policy boundary
    accDescr: Reusable InputSource descriptions are held by InputSources. InputPipeline resolves model variables and request bindings into a generation-tagged ResolvedInput before source-specific owners are opened. Opened source owners are composed into logical InputBatch values, optionally transformed by one InputPolicy, and delivered through an OpenedInput owner. ReconfigurableInput adds a private data and control stream for runtime sessions.

    subgraph Catalog[Resource-free source catalog]
        sources["InputSources"]
        description["InputSource descriptions"]
        native["File, memory, MQTT, Redis, ROS, or channel adapter"]
        native --> description --> sources
    end

    subgraph Plan[Resource-free resolution]
        model["Model input variables"]
        config["Optional InputConfiguration"]
        pipeline["InputPipeline"]
        resolved["Generation-tagged ResolvedInput<br/>InputBinding: variable + Route + FormatId"]
        model --> pipeline
        config --> pipeline
        sources --> pipeline
        pipeline --> resolved
    end

    subgraph Open[Opened owner and logical data]
        open["Open native source owners"]
        owner["OpenedInputSource + InputSourceSet"]
        compose["Compose in locally observed order"]
        policy["One optional InputPolicy"]
        batches["InputBatch: ordered logical ticks"]
        opened["OpenedInput: data stream + owner set"]
        resolved --> open --> owner --> compose --> policy --> batches --> opened
    end

    subgraph Control[Private reconfiguration path]
        control["ReconfigurableInput"]
        items["Data / Reconfigure / Boundary items"]
        session["Persistent InputPipelineSession"]
        control --> items --> session
    end

    opened --> runtime["Ordinary runtime"]
    owner -. "selected control owner" .-> control
