flowchart TD
    subgraph Runtime[Runtime-native output shapes]
        direction TB
        Dataflow[Dataflow: packed fixed-layout rows]
        Semisync[Semi-sync: simultaneous logical rows]
        MSTLO[MSTLO: sparse singleton ticks]
        Async[Async or distributed: singleton ticks in observed merge order]
    end

    Batch[OutputBatch: ordered logical ticks with native segments preserved]
    Shared[Shared stages: producer-to-consumer order]

    subgraph Routing[Global-readiness router]
        direction TB
        Ready[poll_ready waits for every destination writer]
        ScanClone[start_send scans each batch and clones selected values per destination]
        Ready --> ScanClone
    end

    subgraph Destinations[Destination-local processing]
        direction TB
        PrimaryStages[Primary destination-local stages]
        SecondaryStages[Secondary destination-local stages]
        PrimaryBackend[Backend: stdout, null, limited-null, manual, or custom]
        SecondaryBackend[Backend: MQTT, Redis, or ROS]
        PrimaryStages --> PrimaryBackend
        SecondaryStages --> SecondaryBackend
    end

    Dataflow --> Batch
    Semisync --> Batch
    MSTLO --> Batch
    Async --> Batch
    Batch --> Shared
    Shared --> Ready
    ScanClone --> PrimaryStages
    ScanClone --> SecondaryStages

    Pressure[No full pressure isolation: one slow or blocked destination can hold producer admission]
    Routing -. global pressure coupling .-> Pressure
